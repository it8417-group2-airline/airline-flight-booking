# =====================================================================
# .env.example  (Abrar - Member 1)
# Settings for the command-line scripts in vector/ (the dashboard reads
# .streamlit/secrets.toml instead). Copy the values you need into your
# terminal session - NEVER commit real values (.env is git-ignored).
#
#   PowerShell :  $env:DATABASE_URL = "postgresql://..."
#   bash / zsh :  export DATABASE_URL="postgresql://..."
# =====================================================================

# Supabase PostgreSQL - Project Settings -> Database -> Connect -> Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Google Gemini embeddings (gemini-embedding-001, 1536 dimensions) - https://aistudio.google.com/apikey
GEMINI_API_KEY=<gemini-api-key>

# MongoDB Atlas (Member 3) - only needed for:  python vector/embed_flight_notes.py --include-mongo
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=airline
