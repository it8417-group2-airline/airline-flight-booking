# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> Settings -> Secrets.
# NEVER commit the real secrets.toml (it is git-ignored in every folder).

[postgres]
# Supabase -> Project Settings -> Database -> Connect -> Session pooler (port 5432)
url = "postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

[embeddings]
# https://aistudio.google.com/apikey  (model gemini-embedding-001, 1536 dimensions)
GEMINI_API_KEY = "<gemini-api-key>"

[mongo]
# Member 3's MongoDB Atlas cluster - used by the "Also embed MongoDB review comments" option on page 4
uri = "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"
db  = "airline"
